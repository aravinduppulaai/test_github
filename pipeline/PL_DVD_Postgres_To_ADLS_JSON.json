{
	"name": "PL_DVD_Postgres_To_ADLS_JSON",
	"properties": {
		"activities": [
			{
				"name": "LK_Get_Active_Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT\n    c.control_id,\n    c.source_schema,\n    c.source_table,\n    c.load_type,\n    c.watermark_column,\n    w.last_watermark_value,\n    FORMAT(\n        TRY_CONVERT(DATETIME2(6), w.last_watermark_value),\n        'yyyy-MM-dd HH:mm:ss.ffffff'\n    ) AS last_watermark_value_str\nFROM etl.etl_control_table c\nJOIN etl.etl_watermark_table w\n    ON c.control_id = w.control_id\nWHERE c.is_active = 1\n  AND c.source_table in ('customer','actor');",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_Process_Each_Table",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LK_Get_Active_Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LK_Get_Active_Tables').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "usp_update_watermark",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Lookup_Max_Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[etl].[usp_update_watermark]",
								"storedProcedureParameters": {
									"control_id": {
										"value": {
											"value": "@item().control_id",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"last_watermark_value": {
										"value": {
											"value": "@activity('Lookup_Max_Watermark').output.firstRow.max_watermark_value",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Lookup_Max_Watermark",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Condition",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "PostgreSqlV2Source",
									"query": {
										"value": "@concat(\n    'SELECT TO_CHAR(MAX(',\n    item().watermark_column,\n    '), ''YYYY-MM-DD HH24:MI:SS.US'') AS max_watermark_value FROM ',\n    item().source_schema,\n    '.',\n    item().source_table,\n    ' WHERE ',\n    item().watermark_column,\n    ' > ''',\n    item().last_watermark_value_str,\n    ''''\n)",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00"
								},
								"dataset": {
									"referenceName": "DS_SRC_PostgreSQL_Active_tables",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Lookup_Check_Row_Count",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "@if(\n    equals(item().load_type, 'FULL'),\n    concat(\n        'SELECT COUNT(*) AS row_count FROM ',\n        item().source_schema,\n        '.',\n        item().source_table\n    ),\n    concat(\n        'SELECT COUNT(*) AS row_count FROM ',\n        item().source_schema,\n        '.',\n        item().source_table,\n        ' WHERE ',\n        item().watermark_column,\n        ' > ''',\n        item().last_watermark_value_str,\n        ''''\n    )\n)",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Condition",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Lookup_Check_Row_Count",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(int(activity('Lookup_Check_Row_Count').output.firstRow.row_count), 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy data1_copy2",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "PostgreSqlV2Source",
												"query": {
													"value": "@if(\n    equals(item().load_type, 'FULL'),\n    concat(\n        'SELECT * FROM ',\n        item().source_schema,\n        '.',\n        item().source_table\n    ),\n    concat(\n        'SELECT * FROM ',\n        item().source_schema,\n        '.',\n        item().source_table,\n        ' WHERE ',\n        item().watermark_column,\n        ' > ''',\n        item().last_watermark_value_str,\n        ''''\n    )\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00"
											},
											"sink": {
												"type": "JsonSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "JsonWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_SRC_PostgreSQL_Dynamic",
												"type": "DatasetReference",
												"parameters": {
													"schema": "@item().source_schema",
													"table_name": "@item().source_table"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_TGT_ADLSGen2_JSON_Dynamic",
												"type": "DatasetReference",
												"parameters": {
													"S_folder_path": "@concat('bronze/', item().source_table)"
												}
											}
										]
									}
								],
								"ifTrueActivities": [
									{
										"name": "Copy data1_copy1",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "PostgreSqlV2Source",
												"query": {
													"value": "@if(\n    equals(item().load_type, 'FULL'),\n    concat(\n        'SELECT * FROM ',\n        item().source_schema,\n        '.',\n        item().source_table\n    ),\n    concat(\n        'SELECT * FROM ',\n        item().source_schema,\n        '.',\n        item().source_table,\n        ' WHERE ',\n        item().watermark_column,\n        ' > ''',\n        item().last_watermark_value_str,\n        ''''\n    )\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00"
											},
											"sink": {
												"type": "JsonSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "JsonWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_SRC_PostgreSQL_Dynamic",
												"type": "DatasetReference",
												"parameters": {
													"schema": "@item().source_schema",
													"table_name": "@item().source_table"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_TGT_ADLSGen2_JSON_Dynamic",
												"type": "DatasetReference",
												"parameters": {
													"S_folder_path": "@concat('bronze/', item().source_table)"
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}