{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"AzureSqlDatabase1": {
			"type": "string"
		},
		"LS_SRC_PostgreSQL_DEV": {
			"type": "string"
		},
		"lsplocalhost": {
			"type": "string"
		},
		"DS_SRC_PostgreSQL_Dynamic": {
			"type": "string"
		},
		"LS_TGT_ADLSGen2_DEV": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_DVD_Postgres_To_ADLS_JSON')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LK_Get_Active_Tables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    c.control_id,\n    c.source_schema,\n    c.source_table,\n    c.load_type,\n    c.watermark_column,\n    w.last_watermark_value,\n    FORMAT(\n        TRY_CONVERT(DATETIME2(6), w.last_watermark_value),\n        'yyyy-MM-dd HH:mm:ss.ffffff'\n    ) AS last_watermark_value_str\nFROM etl.etl_control_table c\nJOIN etl.etl_watermark_table w\n    ON c.control_id = w.control_id\nWHERE c.is_active = 1;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference"
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FE_Process_Each_Table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LK_Get_Active_Tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LK_Get_Active_Tables').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "usp_update_watermark",
									"type": "SqlServerStoredProcedure",
									"dependsOn": [
										{
											"activity": "Lookup_Max_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"storedProcedureName": "[[etl].[usp_update_watermark]",
										"storedProcedureParameters": {
											"control_id": {
												"value": {
													"value": "@item().control_id",
													"type": "Expression"
												},
												"type": "Int32"
											},
											"last_watermark_value": {
												"value": {
													"value": "@activity('Lookup_Max_Watermark').output.firstRow.max_watermark_value",
													"type": "Expression"
												},
												"type": "String"
											}
										}
									},
									"linkedServiceName": {
										"referenceName": "[parameters('AzureSqlDatabase1')]",
										"type": "LinkedServiceReference"
									}
								},
								{
									"name": "Lookup_Max_Watermark",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "Condition",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "@concat(\n    'SELECT TO_CHAR(MAX(',\n    item().watermark_column,\n    '), ''YYYY-MM-DD HH24:MI:SS.US'') AS max_watermark_value FROM ',\n    item().source_schema,\n    '.',\n    item().source_table,\n    ' WHERE ',\n    item().watermark_column,\n    ' > ''',\n    item().last_watermark_value_str,\n    ''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "DS_SRC_PostgreSQL_Active_tables",
											"type": "DatasetReference"
										}
									}
								},
								{
									"name": "Lookup_Check_Row_Count",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": "@if(\n    equals(item().load_type, 'FULL'),\n    concat(\n        'SELECT COUNT(*) AS row_count FROM ',\n        item().source_schema,\n        '.',\n        item().source_table\n    ),\n    concat(\n        'SELECT COUNT(*) AS row_count FROM ',\n        item().source_schema,\n        '.',\n        item().source_table,\n        ' WHERE ',\n        item().watermark_column,\n        ' > ''',\n        item().last_watermark_value_str,\n        ''''\n    )\n)",
											"queryTimeout": "02:00:00"
										},
										"dataset": {
											"referenceName": "PostgreSqlTable1",
											"type": "DatasetReference"
										}
									}
								},
								{
									"name": "Condition",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "Lookup_Check_Row_Count",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@greater(int(activity('Lookup_Check_Row_Count').output.firstRow.row_count), 0)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "Copy data1_copy1",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "PostgreSqlV2Source",
														"query": {
															"value": "@if(\n    equals(item().load_type, 'FULL'),\n    concat(\n        'SELECT * FROM ',\n        item().source_schema,\n        '.',\n        item().source_table\n    ),\n    concat(\n        'SELECT * FROM ',\n        item().source_schema,\n        '.',\n        item().source_table,\n        ' WHERE ',\n        item().watermark_column,\n        ' > ''',\n        item().last_watermark_value_str,\n        ''''\n    )\n)",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00"
													},
													"sink": {
														"type": "JsonSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "JsonWriteSettings"
														}
													},
													"enableStaging": false
												},
												"inputs": [
													{
														"referenceName": "DS_SRC_PostgreSQL_Dynamic",
														"type": "DatasetReference",
														"parameters": {
															"schema": "@item().source_schema",
															"table_name": "@item().source_table"
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_TGT_ADLSGen2_JSON_Dynamic",
														"type": "DatasetReference",
														"parameters": {
															"S_folder_path": "@concat('bronze/', item().source_table)"
														}
													}
												]
											}
										]
									}
								}
							]
						}
					}
				],
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/datasets/DS_SRC_PostgreSQL_Active_tables')]",
				"[concat(variables('factoryId'), '/datasets/PostgreSqlTable1')]",
				"[concat(variables('factoryId'), '/datasets/DS_SRC_PostgreSQL_Dynamic')]",
				"[concat(variables('factoryId'), '/datasets/DS_TGT_ADLSGen2_JSON_Dynamic')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureSqlTable1')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('AzureSqlDatabase1')]",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_SRC_PostgreSQL_Active_tables')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('LS_SRC_PostgreSQL_DEV')]",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/PostgreSqlTable1')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('lsplocalhost')]",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_SRC_PostgreSQL_Dynamic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('DS_SRC_PostgreSQL_Dynamic')]",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"schema": {
						"type": "string"
					},
					"table_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "PostgreSqlV2Table",
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_TGT_ADLSGen2_JSON_Dynamic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('LS_TGT_ADLSGen2_DEV')]",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"S_folder_path": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(     item().source_table,     '_',     formatDateTime(utcNow(), 'yyyyMMddHHmmss'),     '.json' )",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().S_folder_path",
							"type": "Expression"
						},
						"fileSystem": "raw"
					}
				},
				"schema": {}
			},
			"dependsOn": []
		}
	]
}